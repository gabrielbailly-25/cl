SESSION_SECRET=cambia-este-secreto
ADMIN_EMAILS=gabriel.bailly@gmail.com
APP_URL=https://tu-proyecto.vercel.app

# Obligatorio en Vercel. URL de conexión de Neon Postgres (con SSL).
# DATABASE_URL=postgresql://usuario:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Obligatorio en Vercel para adjuntos persistentes de Vercel Blob.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Obligatorio para el cron de recordatorios. Usa un secreto largo y aleatorio.
# CRON_SECRET=cambia-este-secreto-de-cron

# SMTP global: obligatorio para recuperar contraseñas y usado para los recordatorios.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Para activar acceso con Google:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=https://tu-proyecto.vercel.app/api/auth/google/callback

# Para las notificaciones push con OneSignal:
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=
